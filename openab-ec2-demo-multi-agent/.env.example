# ============================================================================
# OpenAB Multi-Agent Demo — Single Bot + Router + Backend Agents
# ============================================================================

# --- Discord (1 bot only) ---
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id

# --- Router Agent (receives all messages, orchestrates) ---
ROUTER_API_KEY=your-gemini-api-key

# --- Backend Agents (headless, called by router as tools) ---
PLANNER_API_KEY=your-gemini-api-key
DEVELOPER_API_KEY=your-anthropic-api-key
REVIEWER_API_KEY=your-gemini-api-key

# --- GitHub (optional) ---
GH_TOKEN=
