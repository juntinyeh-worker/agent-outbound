# ============================================================================
# OpenAB Multi-Agent on ECS Fargate
# ============================================================================

# --- AWS ---
AWS_REGION=us-east-1
CLUSTER_NAME=openab-multi-agent
NAMESPACE=openab

# --- Discord (1 bot) ---
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id

# --- API Keys ---
ROUTER_API_KEY=your-gemini-api-key
PLANNER_API_KEY=your-gemini-api-key
DEVELOPER_API_KEY=your-anthropic-api-key
REVIEWER_API_KEY=your-gemini-api-key

# --- GitHub (optional) ---
GH_TOKEN=

# --- ECR repo names (auto-created if missing) ---
ECR_REPO_GEMINI=openab-gemini
ECR_REPO_CLAUDE=openab-claude
