# ============================================================================
# OpenAB 4-Agent Demo — 2x Gemini + 2x Claude
# ============================================================================

# --- Discord Bot Tokens (one per agent — 4 bots needed) ---
DISCORD_BOT_TOKEN_GEMINI1=your-gemini1-bot-token
DISCORD_BOT_TOKEN_GEMINI2=your-gemini2-bot-token
DISCORD_BOT_TOKEN_CLAUDE1=your-claude1-bot-token
DISCORD_BOT_TOKEN_CLAUDE2=your-claude2-bot-token

# --- Discord Channel ---
DISCORD_CHANNEL_ID=your-channel-id

# --- Agent API Keys ---
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- GitHub (optional — enables gh CLI for all agents) ---
GH_TOKEN=

# --- Atlassian (optional — enables Jira + Confluence MCP) ---
ATLASSIAN_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
