# ============================================================================
# OpenAB Agent Demo — Environment Variables
#
# Scenarios:
#   ./start.sh           → 2x Gemini + 2x Claude (needs all tokens below)
#   ./start.sh gemini3   → 3x Gemini only
#   ./start.sh claude2   → 2x Claude only
# ============================================================================

# --- Discord Channel (shared by all agents) ---
DISCORD_CHANNEL_ID=your-channel-id

# --- Gemini Agents ---
GEMINI_API_KEY=your-gemini-api-key
DISCORD_BOT_TOKEN_GEMINI1=your-gemini1-bot-token
DISCORD_BOT_TOKEN_GEMINI2=your-gemini2-bot-token
DISCORD_BOT_TOKEN_GEMINI3=your-gemini3-bot-token

# --- Claude Agents ---
ANTHROPIC_API_KEY=your-anthropic-api-key
DISCORD_BOT_TOKEN_CLAUDE1=your-claude1-bot-token
DISCORD_BOT_TOKEN_CLAUDE2=your-claude2-bot-token

# --- GitHub (optional) ---
GH_TOKEN=
