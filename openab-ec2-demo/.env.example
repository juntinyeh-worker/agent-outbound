# ============================================================================
# OpenAB 4-Agent Demo — Environment Variables
# Fill in all values below, then run: ./start.sh
# ============================================================================

# --- Discord Bot Tokens (one per agent — create at https://discord.com/developers) ---
DISCORD_BOT_TOKEN_KIRO=your-kiro-bot-token
DISCORD_BOT_TOKEN_CLAUDE=your-claude-bot-token
DISCORD_BOT_TOKEN_GEMINI=your-gemini-bot-token
DISCORD_BOT_TOKEN_CODEX=your-codex-bot-token

# --- Discord Channel (all agents share one channel for demo) ---
DISCORD_CHANNEL_ID=your-channel-id

# --- Agent API Keys ---
KIRO_API_KEY=your-kiro-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- GitHub (optional, enables gh CLI inside agents) ---
GH_TOKEN=
