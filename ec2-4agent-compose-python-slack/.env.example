# ============================================================================
# OpenAB 4-Agent Demo — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================================

# --- Platform: "discord" or "slack" ---
PLATFORM=discord

# --- Discord (required if PLATFORM=discord) ---
DISCORD_BOT_TOKEN_KIRO=your-kiro-bot-token
DISCORD_BOT_TOKEN_CLAUDE=your-claude-bot-token
DISCORD_BOT_TOKEN_GEMINI=your-gemini-bot-token
DISCORD_BOT_TOKEN_CODEX=your-codex-bot-token
DISCORD_CHANNEL_ID=your-channel-id

# --- Slack (required if PLATFORM=slack) ---
SLACK_BOT_TOKEN_KIRO=xoxb-your-kiro-slack-bot-token
SLACK_BOT_TOKEN_CLAUDE=xoxb-your-claude-slack-bot-token
SLACK_BOT_TOKEN_GEMINI=xoxb-your-gemini-slack-bot-token
SLACK_BOT_TOKEN_CODEX=xoxb-your-codex-slack-bot-token
SLACK_APP_TOKEN_KIRO=xapp-your-kiro-slack-app-token
SLACK_APP_TOKEN_CLAUDE=xapp-your-claude-slack-app-token
SLACK_APP_TOKEN_GEMINI=xapp-your-gemini-slack-app-token
SLACK_APP_TOKEN_CODEX=xapp-your-codex-slack-app-token
SLACK_CHANNEL_ID=C0123456789

# --- Agent API Keys ---
KIRO_API_KEY=your-kiro-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# --- GitHub (optional, for gh CLI inside agents) ---
GH_TOKEN=ghp_your-github-pat
